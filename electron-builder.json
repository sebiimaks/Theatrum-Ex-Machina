{
  "productName": "Theatrum Ex Machina",
  "appId": "com.github.sebiimaks.theatrumexmachina",
  "copyright": "Copyright © 2022 Boris Yakubchik; fork modifications © 2026 sebiimaks",
  "directories": {
    "output": "release/"
  },
  "files": [
    "dist/**/*",
    "main.js",
    "node/**/*.js",
    "interfaces/**/*.js",
    "i18n/*.json",
    {
      "from": "build/runtime-dependencies/node_modules",
      "to": "node_modules",
      "filter": [
        "**/*"
      ]
    }
  ],
  "extraResources": [
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "build/media-tools",
      "to": "media-tools"
    },
    {
      "from": "build/media-legal",
      "to": "licenses"
    },
    {
      "from": "src/assets/icons/mac/touch-bar",
      "to": "assets"
    },
    {
      "from": "remote",
      "to": "remote"
    },
    {
      "from": "src/assets/logo.png",
      "to": "assets/logo.png"
    },
    {
      "from": "src/assets/favicon-light.png",
      "to": "assets/favicon-light.png"
    },
    {
      "from": "src/assets/favicon-dark.png",
      "to": "assets/favicon-dark.png"
    }
  ],
  "win": {
    "icon": "dist/favicon",
    "asar": true,
    "target": [
      "nsis",
      "portable"
    ]
  },
  "mac": {
    "category": "public.app-category.video",
    "artifactName": "theatrum-ex-machina-v${version}-${arch}.${ext}",
    "target": {
      "target": "dmg",
      "arch": [
        "arm64"
      ]
    },
    "icon": "src/assets/icons.icns",
    "asar": true
  },
  "linux": {
    "icon": "src/assets/icons/png",
    "category": "AudioVideo",
    "synopsis": "Personal fork of Video Hub App",
    "description": "Browse, search, preview, and manage video collections. Theatrum Ex Machina is a personal fork of Video Hub App. Fork changes are made utilising LLMs. The fork is not supported or endorsed by the original developer. Use at your own risk.",
    "maintainer": "sebiimaks <github.sadness446@passmail.net>",
    "vendor": "sebiimaks",
    "desktop": {
      "entry": {
        "Name": "Theatrum Ex Machina",
        "Comment": "Browse, search, preview, and manage video collections",
        "Categories": "AudioVideo;Video;"
      }
    },
    "target": [
      "AppImage",
      "deb"
    ]
  },
  "deb": {
    "packageName": "theatrum-ex-machina",
    "packageCategory": "video",
    "priority": "optional"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true
  },
  "fileAssociations": {
    "ext": "scaena",
    "mimeType": "application/x-theatrum-ex-machina-catalogue",
    "name": "Theatrum Ex Machina catalogue",
    "role": "Editor"
  }
}
