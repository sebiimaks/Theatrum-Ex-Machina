{
  "compilerOptions": {
    "declaration": false,
    "experimentalDecorators": true,
    "lib": [
      "es2023",
      "dom"
    ],
    "moduleResolution": "node",
    "sourceMap": true,
    "target": "es2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "module": "commonjs"
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "main.ts",
    "preload.ts",
    "node/normal-preview-validation-worker.ts"
  ]
}
