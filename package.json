{
  "name": "theatrum-ex-machina",
  "productName": "Theatrum Ex Machina",
  "version": "1.1.3",
  "description": "Theatrum Ex Machina - a personal fork of Video Hub App for browsing, searching, previewing, and managing videos",
  "homepage": "https://github.com/sebiimaks/Theatrum-Ex-Machina",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebiimaks/Theatrum-Ex-Machina.git"
  },
  "author": {
    "name": "Boris Yakubchik",
    "email": "yboris@yahoo.com"
  },
  "contributors": [
    {
      "name": "Cal Martin",
      "url": "https://github.com/cal2195"
    },
    {
      "name": "sebiimaks",
      "email": "github.sadness446@passmail.net",
      "url": "https://github.com/sebiimaks"
    }
  ],
  "keywords": [
    "video"
  ],
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "npm-run-all -p electron:serve ng:serve",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "build:prod": "npm run build -- -c production",
    "buildsize": "sh ./bin/buildSizeCheck.sh",
    "branding:generate": "node ./bin/generate-brand-assets.mjs",
    "check": "npm run check:tsc && npm run check:lint",
    "check:lint": "ng lint --quiet",
    "check:tsc": "tsc --project ./tsconfig.json --noEmit && tsc --project ./tsconfig-serve.json --noEmit && tsc --project ./tsconfig.worker.json --noEmit",
    "electron": "npm run legal:generate && npm run release:preflight && npm run media:prepare && npm run build:prod && electron-builder build && npm run media:source && npm run buildsize",
    "electron:linux:release": "npm run legal:generate && npm run release:preflight && npm run media:prepare && npm run build:prod && electron-builder build --linux deb --x64 --publish never && npm run media:source:linux && npm run verify:linux:release && npm run buildsize",
    "electron:linux:test": "npm run media:prepare && npm run build:prod && electron-builder build --linux deb --x64 --publish never --config.directories.output=release-test && npm run media:source:linux:test && npm run verify:linux:test",
    "electron:mac:release": "npm run legal:generate && npm run release:preflight && npm run media:prepare && npm run build:prod && electron-builder build --mac dmg --arm64 && npm run media:source && npm run verify:mac:release && npm run buildsize",
    "electron:mac:test": "npm run media:prepare && npm run build:prod && electron-builder build --mac dir --arm64 --config.directories.output=release-test && npm run media:source:test && npm run verify:mac:test",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && npx electron . --serve",
    "electron:serve-tsc": "tsc -p tsconfig-serve.json",
    "ng": "ng",
    "lint": "ng lint",
    "legal:generate": "node ./bin/generate-third-party-notices.mjs",
    "media:build": "sh ./bin/build-media-tools.sh",
    "media:ensure": "sh ./bin/ensure-media-tools.sh",
    "media:prepare": "npm run media:ensure && npm run runtime:stage && npm run legal:generate",
    "media:source": "sh ./bin/package-media-source.sh",
    "media:source:linux": "sh ./bin/package-media-source.sh ./release linux-amd64",
    "media:source:linux:test": "sh ./bin/package-media-source.sh ./release-test linux-amd64",
    "media:source:test": "sh ./bin/package-media-source.sh ./release-test",
    "ng:serve": "ng serve",
    "postinstall": "electron-builder install-app-deps",
    "release:preflight": "node ./bin/release-preflight.mjs",
    "runtime:stage": "node ./bin/stage-runtime-dependencies.mjs",
    "test": "npm-run-all -s test:catalogue-file test:catalogue-media-authority test:catalogue-open-coordinator test:catalogue-persistence test:catalogue-session-document test:catalogue-write-authority test:main-filenames test:vha2-compatibility test:legacy-open-safety test:main-ipc-close test:demo-removal test:electron-security test:preload-bridge test:theatrum-protocol test:path-authority test:persistence test:folder-rescan test:folder-thumbnail-session test:thumbnail-regeneration-ipc test:source-folder-tree test:settings-startup test:local-safety test:import-resilience test:media-locations test:thumbnail-count test:thumbnail-batch test:thumbnail-transaction test:date-added test:tag-hierarchy test:catalogue-editor test:catalogue-metadata-transfer test:dialog-presentation test:settings-presentation test:gallery-layout test:virtual-scroll-layout test:package-media-source test:runtime-dependencies test:linux-packaging test:media-toolchain",
    "test:catalogue-file": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-file.test.ts",
    "test:catalogue-media-authority": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-media-authority.test.ts",
    "test:catalogue-open-coordinator": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-open-coordinator.test.ts",
    "test:catalogue-persistence": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-persistence-coordinator.test.ts",
    "test:catalogue-session-document": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-session-document.test.ts",
    "test:catalogue-write-authority": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-write-authority.test.ts",
    "test:main-filenames": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/main-filenames.test.ts",
    "test:catalogue-editor": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-editor.test.ts",
    "test:catalogue-metadata-transfer": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/catalogue-metadata-transfer.test.ts",
    "test:date-added": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/date-added.test.ts",
    "test:demo-removal": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/demo-removal.test.ts",
    "test:electron-security": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/electron-security.test.ts",
    "test:dialog-presentation": "ts-node --project tsconfig.persistence-tests.json node/dialog-presentation.test.ts",
    "test:folder-rescan": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/folder-rescan.test.ts",
    "test:folder-thumbnail-session": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/folder-thumbnail-regeneration-session.test.ts",
    "test:thumbnail-regeneration-ipc": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/thumbnail-regeneration-ipc.test.ts",
    "test:gallery-layout": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/gallery-layout.test.ts",
    "test:source-folder-tree": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/source-folder-tree.test.ts",
    "test:tag-hierarchy": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/tag-hierarchy.test.ts",
    "test:import-resilience": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/media-import-resilience.test.ts",
    "test:media-locations": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/media-locations.test.ts",
    "test:package-media-source": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/package-media-source.test.ts",
    "test:runtime-dependencies": "node --test ./node/runtime-dependencies.test.mjs",
    "test:path-authority": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/path-authority-store.test.ts",
    "test:local-safety": "ts-node --project tsconfig.persistence-tests.json node/local-operation-safety.test.ts",
    "test:legacy-open-safety": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/legacy-open-safety.test.ts",
    "test:linux-packaging": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/linux-packaging.test.ts",
    "test:main-ipc-close": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/main-ipc-close.test.ts",
    "test:media-toolchain": "ts-node --project tsconfig.persistence-tests.json node/media-toolchain.test.ts",
    "test:persistence": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/vha-file-persistence.test.ts",
    "test:preload-bridge": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/preload-bridge.test.ts",
    "test:settings-presentation": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/settings-presentation.test.ts",
    "test:settings-startup": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/settings-startup.test.ts",
    "test:thumbnail-batch": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/sequential-batch.test.ts",
    "test:thumbnail-count": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/thumbnail-count.test.ts",
    "test:thumbnail-transaction": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/thumbnail-transaction.test.ts",
    "test:theatrum-protocol": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/theatrum-protocol-paths.test.ts",
    "test:virtual-scroll-layout": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/virtual-scroll-layout.test.ts",
    "test:vha2-compatibility": "ts-node --preferTsExts --project tsconfig.persistence-tests.json node/vha2-compatibility.test.ts",
    "verify:mac:release": "node ./bin/verify-packaged-app.mjs './release/mac-arm64/Theatrum Ex Machina.app'",
    "verify:mac:test": "node ./bin/verify-packaged-app.mjs './release-test/mac-arm64/Theatrum Ex Machina.app'",
    "verify:linux:release": "node ./bin/verify-packaged-linux.mjs ./release/linux-unpacked ./release/theatrum-ex-machina-media-source-v$npm_package_version-linux-amd64.tar.xz",
    "verify:linux:test": "node ./bin/verify-packaged-linux.mjs ./release-test/linux-unpacked ./release-test/theatrum-ex-machina-media-source-v$npm_package_version-linux-amd64.tar.xz"
  },
  "dependencies": {
    "@iharbeck/ngx-virtual-scroller": "19.0.1",
    "@ngx-translate/core": "17.0.0",
    "async": "3.2.6",
    "chokidar": "4.0.3",
    "electron-window-state": "5.0.3",
    "fdir": "6.5.0",
    "fuse.js": "7.1.0",
    "natural-orderby": "5.0.0",
    "object-hash": "^3.0.0",
    "path": "0.12.7",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.36",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular/animations": "20.3.30",
    "@angular/cdk": "20.2.14",
    "@angular/cli": "20.3.36",
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/compiler-cli": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.30",
    "@angular/platform-browser-dynamic": "20.3.30",
    "@angular/router": "20.3.30",
    "@electron/asar": "3.4.1",
    "@tweenjs/tween.js": "25.0.0",
    "@types/node": "24.9.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "baseline-browser-mapping": "2.10.37",
    "electron": "42.11.1",
    "electron-builder": "26.16.0",
    "electron-reload": "1.5.0",
    "eslint": "9.39.5",
    "npm-run-all": "4.1.5",
    "rxjs": "7.8.2",
    "stylelint": "16.25.0",
    "stylelint-config-recommended-scss": "16.0.2",
    "stylelint-order": "7.0.0",
    "stylelint-scss": "6.12.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "wait-on": "9.0.1",
    "zone.js": "0.15.1"
  },
  "optionalDependencies": {
    "dmg-license": "1.0.11"
  },
  "browserslist": [
    "chrome 140"
  ]
}
